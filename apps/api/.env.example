# BACKEND ONLY. Never include values in the Angular bundle.
PORT=8080
ALLOWED_WEB_ORIGINS=http://localhost:4200
# Optional exact owned Vercel preview origin for temporary QA; empty in normal production.
KTOB_QA_WEB_ORIGIN=
# Local/disposable Postgres for M1; NO production connection until migration review:
DATABASE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/ktob_dev
DATABASE_USERNAME=ktob_app
DATABASE_PASSWORD=REPLACE_LOCALLY_DO_NOT_COMMIT
SUPABASE_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
OPENLIBRARY_CONTACT=YOUR_PUBLIC_APPLICATION_CONTACT
VERIFIED_OFFERS_ENABLED=false
# Optional AI: owner adds GROQ_API_KEY privately in Render. Never commit a real value.
GROQ_API_KEY=
# Deployment operator sets true only after provider/consent/privacy qualification.
KTOB_GROQ_QUALIFIED=false
