# Browser-only configuration. Do not store a service_role key, DB password or AI key.
# Read by scripts/configure-api.mjs only if set in the process environment.
KTOB_API_URL=http://localhost:8080/api/v1
# For Sprint 1 Auth; Supabase publishable keys are public browser configuration.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_KEY
