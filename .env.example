# KTOB local environment reference. Placeholders only.
# Never commit an actual .env file. This file is documentation, not an auto-loader.
#
# Java backend (Sprint 1+)
PORT=8080
ALLOWED_WEB_ORIGINS=http://localhost:4200
DATABASE_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/ktob_dev
DATABASE_USERNAME=ktob_app
DATABASE_PASSWORD=REPLACE_LOCALLY_DO_NOT_COMMIT
SUPABASE_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
OPENLIBRARY_CONTACT=YOUR_PUBLIC_APPLICATION_CONTACT
#
# Browser app (KTOB-002)
KTOB_API_URL=http://localhost:8080/api/v1
# Supabase Auth in the browser (Sprint 1+): these keys are public (NOT service_role).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_PUBLISHABLE_KEY
#
# External integrations stay disabled until separate approval (B15/B16).
AI_ENABLED=false
VERIFIED_OFFERS_ENABLED=false
