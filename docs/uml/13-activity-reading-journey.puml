@startuml KTOB_13_activity_reading_journey
title KTOB - Reader Journey (R1, optional paths)
start
:Authenticate reader;
if (Known catalog work?) then (yes)
 :Choose an accessible work;
else (no)
 :Create private manual work owned by reader;
endif
:Add to personal library (WANT_TO_READ projection);
if (Start actual reading?) then (yes)
 :Create CURRENTLY_READING experience;
 :Optionally update dates, progressPercent (0..100),\n  rating (1..5 half-stars) and status independently;
 if (Reflection?) then (yes)
  :Save journal and explicit AI exclusion flag;
 endif
else (no)
 :Keep entry with no ReadingExperience;
endif
if (Recommendations or AI chat?) then (yes)
 :Choose spoilerLevel (NO_SPOILERS default);
 if (FULL_BOOK_SPOILERS chosen?) then (yes)
  :Require explicit confirmation for this request;
 endif
 if (AI processing consent current?) then (yes)
  if (Personalization allowed for this request?) then (yes)
   :Select only authorized history and journal content;
  else (no)
   :Send request-only content;
  endif
  :Recheck processing consent before external dispatch;
  if (Still allowed?) then (yes)
   :Call AI, apply firm boundaries, return qualified result;
  else (no)
   :Return consent-required error; no AI call;
  endif
 else (no)
  :Return consent-required error; no AI call;
 endif
endif
if (Find a copy?) then (yes)
 if (Verified provider configured?) then (yes)
  :Return sourced listings with observedAt;
 else (no)
  :Show provider-unavailable empty state;
 endif
 if (Reader saves a listing?) then (yes)
  :Save historical offer without recording purchase;
 endif
 if (Actually acquired?) then (yes)
  :Record acquisition without altering reading state;
 endif
endif
:Library, readings and collections remain reader-private;
stop
@enduml
