@startuml KTOB_03_domain_advisor
title KTOB - Advisor, Consent, Recommendation and Memory
hide empty methods
skinparam classAttributeIconSize 0
class ReaderProfile {
 +readerId: UUID
}
class PrivacySettings {
 +aiProcessingOptIn: Boolean
 +personalizationOptIn: Boolean
 +useReadingHistory: Boolean
 +useAllowedJournal: Boolean
 +useExplicitPreferences: Boolean
 +useApprovedMemories: Boolean
}
class ReadingPreference {
 +preferenceId: UUID
 +category: String
 +description: String
 +source: PreferenceSource
}
enum PreferenceSource {
 READER_ENTERED
 AI_APPROVED
}
class ContentBoundary {
 +boundaryId: UUID
 +category: String
 +firm: Boolean
 +active: Boolean
}
class BoundaryException {
 +exceptionId: UUID
 +explicitlyAuthorized: Boolean
 +createdAt: DateTime
}
class Conversation {
 +conversationId: UUID
 +kind: ConversationKind
 +workId: UUID [0..1]
}
enum ConversationKind {
 GENERAL
 BOOK_MAIN
}
class Message {
 +messageId: UUID
 +role: MessageRole
 +body: Text
 +spoilerLevel: SpoilerLevel [0..1]
 +fullBookSpoilersConfirmed: Boolean [0..1]
}
enum MessageRole {
 READER
 ASSISTANT
}
class MemoryProposal {
 +proposalId: UUID
 +suggestedText: Text
 +status: MemoryStatus
}
enum MemoryStatus {
 PENDING
 APPROVED
 DISMISSED
 REVOKED
}
class ApprovedMemory {
 +memoryId: UUID
 +text: Text
 +approvedAt: DateTime
 +revokedAt: DateTime [0..1]
}
class RecommendationRequest {
 +requestId: UUID
 +discoveryMode: DiscoveryMode
 +usePersonalContext: Boolean
 +spoilerLevel: SpoilerLevel
 +fullBookSpoilersConfirmed: Boolean
}
enum SpoilerLevel {
 NO_SPOILERS
 FULL_BOOK_SPOILERS
}
enum DiscoveryMode {
 BALANCED
 COMFORT
 SURPRISE
}
class Recommendation {
 +recommendationId: UUID
 +explanation: Text
 +warningConfidence: WarningConfidence
}
enum WarningConfidence {
 KNOWN
 PARTIAL
 UNKNOWN
}
class BookWork {
 +workId: UUID
}
class ReadingExperience {
 +experienceId: UUID
}
class JournalEntry {
 +journalId: UUID
}
ReaderProfile "1" -- "1" PrivacySettings
ReaderProfile "1" -- "0..*" ReadingPreference
ReaderProfile "1" -- "0..*" ContentBoundary
ReaderProfile "1" -- "0..*" Conversation
Conversation "1" -- "0..*" Message
Conversation "0..*" --> "0..1" BookWork : book context >
Message "1" -- "0..*" MemoryProposal : suggests >
MemoryProposal "1" --> "0..1" ApprovedMemory : approved as >
ReaderProfile "1" -- "0..*" ApprovedMemory
ReaderProfile "1" -- "0..*" RecommendationRequest
RecommendationRequest "1" -- "0..*" Recommendation : returns items >
Recommendation "0..*" --> "1" BookWork
RecommendationRequest "1" -- "0..*" BoundaryException
BoundaryException "0..*" --> "1" ContentBoundary
JournalEntry "0..*" --> "1" ReadingExperience
note right of PrivacySettings
Both opt-ins default FALSE.
Before dispatch, verify AI processing opt-in.
Personalization requires separate authorization
and journal-specific exclusion filtering.
end note
note right of Message
Spoiler metadata is recorded on reader messages / turns.
NO_SPOILERS by default for each AI call; explicit
FULL_BOOK_SPOILERS confirmation is per message request.
No permanent spoiler setting is inferred.
end note
note bottom of ApprovedMemory
One per approved proposal; revoked is terminal.
No active=true generic PATCH reactivation.
end note
note bottom of RecommendationRequest
Request-scoped exceptions never edit preferences.
Default NO_SPOILERS; FULL_BOOK_SPOILERS requires
explicit confirmation for THIS request only.
Content boundaries remain independent of spoiler level.
Results are a batch, not one item.
end note
@enduml
